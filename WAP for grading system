#include <stdio.h>

int main() {
    int mark;

    printf("Enter marks: ");
    scanf("%d", &mark);

    if (mark >= 90 && mark <= 100)
        printf("Grade A");
    else if (mark >= 80)
        printf("Grade B");
    else if (mark >= 70)
        printf("Grade C");
    else if (mark >= 0)
        printf("Fail");
    else
        printf("Invalid marks");

    return 0;
}
